// Product identity is intentionally centralized here.
PRODUCT_NAME = Tunnelful
PRODUCT_BUNDLE_IDENTIFIER = app.tunnelful.mac
PRODUCT_MODULE_NAME = TunnelApp
MARKETING_VERSION = 0.1.7
CURRENT_PROJECT_VERSION = 15
TUNNELFUL_RELEASE_VERSION = 0.1.7

MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 5.0
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(PRODUCT_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.developer-tools
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSAppTransportSecurity_NSAllowsLocalNetworking = YES
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 Tunnelful contributors.
INFOPLIST_KEY_TunnelfulReleaseVersion = $(TUNNELFUL_RELEASE_VERSION)
INFOPLIST_KEY_SUFeedURL = https://ihopefulchina.github.io/Tunnelful/appcast.xml
INFOPLIST_KEY_SUPublicEDKey = 0hyxOLR9zBFNvSdozSz0hALE/wHrk72Vsad4KxqpyM0=
INFOPLIST_KEY_SUEnableAutomaticChecks = YES
INFOPLIST_KEY_SUVerifyUpdateBeforeExtraction = YES

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = TunnelApp/Tunnelful.entitlements
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
